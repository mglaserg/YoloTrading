RW_API_KEY=
RW_BASE_URL=https://api.robotwealth.com/v1

HL_ACCOUNT_ADDRESS=
# Strongly preferred for YOLO, and required by default for compound sizing.
HL_YOLO_SUBACCOUNT_ADDRESS=

# Explicit deployment controls. v0.5 accepts plan only; execute is hard-blocked.
YOLO_NETWORK=testnet
YOLO_EXECUTION_MODE=plan

# Base sizing knob. In fixed mode this is today's nominal forever.
# In compound mode this is the nominal at NAV-per-unit = 1.0.
YOLO_NOMINAL_USD=50000
YOLO_SIZING_MODE=compound
YOLO_MIN_NOMINAL_MULTIPLIER=0.25
YOLO_MAX_NOMINAL_MULTIPLIER=3.00
YOLO_REQUIRE_DEDICATED_SUBACCOUNT_FOR_COMPOUND=true

# Hyperliquid cash-flow ledger is auto-synced for compound sizing.
YOLO_AUTO_SYNC_CASH_FLOWS=true
YOLO_CASHFLOW_LOOKBACK_DAYS=7

YOLO_ACCOUNT_COLLATERAL_USD=20000
YOLO_MARGIN_REQUIRED=0.10
YOLO_MOMENTUM_MULTIPLIER=1.0
YOLO_TREND_MULTIPLIER=1.0
YOLO_CARRY_MULTIPLIER=1.0
YOLO_TRADE_BUFFER=0.02
YOLO_BUFFER_MODE=edge
YOLO_MAX_ASSET_WEIGHT=0.25
YOLO_MAX_GROSS_WEIGHT=1.0
YOLO_MAX_MARGIN_UTILIZATION=0.60
YOLO_EXPECTED_UNIVERSE_SIZE=10
YOLO_CLOSE_NON_UNIVERSE_POSITIONS=true
YOLO_MIN_ORDER_USD=10
YOLO_DATA_DIR=state
YOLO_REQUEST_TIMEOUT_SECONDS=15

# Backward-compatible v0.4 aliases; YOLO_NETWORK / YOLO_EXECUTION_MODE win when set.
DRY_RUN=true
HYPERLIQUID_TESTNET=true
# Optional explicit endpoint override:
# HL_API_URL=https://api.hyperliquid.xyz

# Linux/systemd signal-publish window
YOLO_SIGNAL_POLL_SECONDS=30
YOLO_SIGNAL_WAIT_MINUTES=15
