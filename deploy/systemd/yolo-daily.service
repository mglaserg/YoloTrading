[Unit]
Description=Crypto YOLO daily pre-live planner
[Service]
Type=oneshot
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment="YOLO_PYTHON=@PYTHON_BIN@"
Environment="YOLO_DATA_DIR=@DATA_DIR@"
ExecStart="@REPO_DIR@/bin/yolo" --wait-for-signal
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
